{
    "name": "xpier/filament-media-library",
    "description": "A Filament-native media library with folder browser, inline upload, soft deletes, and a drop-in MediaPicker form field.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "filament",
        "filament-plugin",
        "media-library",
        "media-picker",
        "media-manager",
        "laravel",
        "admin-panel"
    ],
    "authors": [
        {
            "name": "Gouki",
            "email": "gouki.xiao@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.3",
        "laravel/framework": "^12.0",
        "livewire/livewire": "^4.2"
    },
    "require-dev": {
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Xpier\\FilamentMediaLibrary\\Tests\\": "tests/"
        }
    },
    "autoload": {
        "psr-4": {
            "Xpier\\FilamentMediaLibrary\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Xpier\\FilamentMediaLibrary\\FilamentMediaLibraryServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
